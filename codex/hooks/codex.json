{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/watcher.mjs\" start",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
