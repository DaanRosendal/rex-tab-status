{
  "name": "rex-tab-status",
  "description": "Prefix the Rex tab label with an emoji for the coding agent's state",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaanRosendal/rex-tab-status.git"
  },
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      "./pi/extension.mjs"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test 'tests/*.test.mjs'",
    "test:integration": "node --test tests/integration/rex.test.mjs",
    "validate": "claude plugin validate plugin && claude plugin validate .",
    "format": "npx --yes prettier@3 --write .",
    "format:check": "npx --yes prettier@3 --check ."
  }
}
