{
  "name": "rex-tab-status",
  "version": "0.4.1",
  "description": "Prefix the Rex tab label with an emoji for the coding agent's state",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaanRosendal/rex-tab-status.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test tests/core.test.mjs tests/tabs.test.mjs tests/themes.test.mjs tests/watcher.test.mjs tests/lock.test.mjs tests/manifest.test.mjs",
    "test:plugin": "claude plugin test claude",
    "test:integration": "node --test tests/rex-integration.test.mjs",
    "validate": "claude plugin validate claude",
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "version:check": "node scripts/version.mjs --check",
    "bump": "node scripts/version.mjs",
    "format": "npx --yes prettier@3 --write .",
    "format:check": "npx --yes prettier@3 --check ."
  }
}
